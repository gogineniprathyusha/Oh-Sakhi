{
  "name": "oh-sakhi",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run typecheck && npm run lint",
    "check:functions": "npx --yes deno@2.9.6 check --config supabase/functions/event-image/deno.json supabase/functions/event-image/index.ts supabase/functions/delete-account/index.ts",
    "test": "node --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test:db": "node --test --test-concurrency=1 tests/database/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint src tests supabase/functions vite.config.ts playwright.config.ts eslint.config.mjs",
    "format": "prettier --write src tests supabase/functions *.ts *.json *.mjs index.html README.md docs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@imagemagick/magick-wasm": "0.0.44",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "pg": "8.23.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
